# Default: ignore everything in this repository.
*

# Keep tracked metadata files.
!.gitignore
!.gitattributes

# Explicit secret and key patterns (redundant with *, kept for clarity).
.env
.env.*
*.env
*api_key*
*apikey*
*secret*
*token*
*credential*
api.json
openai_api.json
hf_api
ant_api

# Explicitly ignore requested file types across repo.
*.txt
*.md
*.sh

# Keep the reproducible environment guide and dependency declaration.
!requirements.txt
!runbook.md
!scripts/test_openai_connection.py
!scripts/run_safedial_baseline.py
!scripts/judge_safedial.py

# Allow directory traversal so selective un-ignores can match nested files.
!*/

# Keep core methodology code (Python sources only).
!src/**/*.py
src/**/__pycache__/
__pycache__/
*.py[cod]
*$py.class

# Curated model index for students.
!models/MANIFEST.json

# Hierarchical final-method regret critics (Git LFS).
!outputs/cares_hierarchical_regret_critic/hierarchical_regret_critic/checkpoints/value_function_latest.pt
!outputs/cares_hierarchical_regret_critic/hierarchical_regret_critic/checkpoints/value_function_latest_aug11.pt
!outputs/wildjailbreak_hierarchical_regret_critic/hierarchical_regret_critic/checkpoints/value_function_final.pt
!outputs/wildjailbreak_hierarchical_regret_critic/hierarchical_regret_critic/checkpoints/value_function_final_aug11.pt

# SafeDialBench implementation, launchers, and reproducibility evidence.
!AGENTS.md
!.agents.md
!handover.md
!EXPERIMENT_LOGBOOK.md
!safedial_dcgs.json
!cares_smoke.json
!scripts/**
!tests/**
!configs/safedial/**
!docs/**
!archive/scripts_cleanup_20260918/**

# Local installations, external datasets, generated runs, and credentials.
.venv/
.cache/
benchmark-artifacts/
**/__pycache__/
*.py[cod]
.env
.env.*
*.env
*api_key*
*apikey*
*secret*
*credential*
api.json
openai_api.json
hf_api
ant_api
