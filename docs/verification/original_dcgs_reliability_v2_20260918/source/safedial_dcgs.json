{
  "model_name": "HuggingFaceH4/zephyr-7b-beta",
  "device": "cuda",
  "use_bf16": true,
  "environment_type": "wildjailbreak",
  "checkpoint_path": "outputs/wildjailbreak_hierarchical_regret_critic/hierarchical_regret_critic/checkpoints/value_function_final.pt",
  "use_hierarchical_agent": true,
  "high_level_policy_type": "freeform",
  "critic_only_training": true,
  "n_candidates": 5,
  "freeform_n_instructions": 5,
  "use_regret_critic": true,
  "regret_critic_beta": 0.2,
  "regret_zero_sum_targets": true,
  "regret_min_target_mode": "sampled_q_min",
  "mlp_width_mult": 1.0,
  "critic_lora_r": 0,
  "epsilon": 0.0,
  "ll_action_belief_only": true,
  "ll_candidate_rerank": false,
  "q_value_chunk_size": 4,
  "batch_generation_chunk_size": 1,
  "debug": false
}
